# Copy this file to .env only if you use a dotenv loader,
# or set these values in your shell before running the app.
#
# The app uses Google Gemini by default because its free tier does not
# require a credit card. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# Optional. Set to "openai" to use OpenAI instead of Gemini.
# AI_PROVIDER=openai
# OPENAI_API_KEY=your_openai_key_here
